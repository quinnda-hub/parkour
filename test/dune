; To add a test executable: add its name to `names` and a `run` line to the test-long rule.

(tests
 (names test_harness test_support_modules test_engine)
 (libraries parkour parkour_test_support qcheck-core qcheck-core.runner))

(rule
 (alias test-long)
 (action
  (progn
   (run %{exe:test_harness.exe} --long)
   (run %{exe:test_support_modules.exe} --long)
   (run %{exe:test_engine.exe} --long))))
