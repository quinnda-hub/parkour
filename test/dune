; To add a test executable: add its name to `names` and a `run` line to the test-long rule.

(tests
 (modules :standard \ test_stack)
 (names
  test_harness
  test_support_modules
  test_engine
  test_source_render
  test_text
  test_expr
  test_recovery
  test_tokens
  test_robustness)
 (libraries parkour parkour_test_support qcheck-core qcheck-core.runner))

(rule
 (alias test-long)
 (action
  (progn
   (run %{exe:test_harness.exe} --long)
   (run %{exe:test_support_modules.exe} --long)
   (run %{exe:test_engine.exe} --long)
   (run %{exe:test_source_render.exe} --long)
   (run %{exe:test_text.exe} --long)
   (run %{exe:test_expr.exe} --long)
   (run %{exe:test_recovery.exe} --long)
   (run %{exe:test_tokens.exe} --long)
   (run %{exe:test_robustness.exe} --long))))

; The stack backstop needs a small stack limit (OCaml 5; ignored by 4.14, whose
; native stack is the system's 8 MB).

(executable
 (name test_stack)
 (modules test_stack)
 (libraries parkour parkour_test_support qcheck-core qcheck-core.runner))

(rule
 (alias runtest)
 (action
  (setenv
   OCAMLRUNPARAM
   l=100000
   (run %{exe:test_stack.exe}))))

(rule
 (alias test-long)
 (action
  (setenv
   OCAMLRUNPARAM
   l=100000
   (run %{exe:test_stack.exe} --long))))
