; Benchmarks: parkour against Angstrom, MParser, Yojson and ocamllex+menhir.
; Not part of the package, and only built in the bench profile, so the main
; build never needs the bench-only libraries (they live in the project switch,
; not in the opam dependencies):
;
;   dune exec --profile bench bench/main.exe -- [--quick] [--errors]
;
; Run `bench/fetch.sh` once to download the JSON fixtures.

(executable
 (name main)
 (enabled_if
  (= %{profile} bench))
 (libraries parkour angstrom mparser yojson bechamel))

(ocamllex
 (modules json_lexer expr_lexer)
 (enabled_if
  (= %{profile} bench)))

(menhir
 (modules json_parser expr_parser)
 (enabled_if
  (= %{profile} bench)))
