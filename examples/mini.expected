fn fib(n) {
  if (n < 2) {
    return n;
  } else if (n == 2) {
    return 1;
  } else {
    return (fib((n - 1)) + fib((n - 2)));
  }
}
fn greet(name, excited) {
  let punctuation = "!";
  if !excited {
    punctuation = ".";
  }
  print((("hello, " + name) + punctuation));
}
let i = 0;
while ((i < 10) && !done(i)) {
  print(((fib(i) * -2) + 1));
  i = (i + 1);
}
greet("world", true);
